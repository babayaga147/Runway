<section class="sx-block" id="pieces">
  <div class="sx-wrap">
    <div class="sx-block__head">
      <h2 class="sx-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="sx-link" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="sx-feat">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product -%}
          <a class="sx-card" href="{{ product.url }}" {{ block.shopify_attributes }}>
            <div class="sx-card__img">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="400" height="{{ 400 | divided_by: product.featured_image.aspect_ratio | round }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="sx-card__row"><h3>{{ product.title }}</h3><span class="sx-card__price">{{ product.price | money }}</span></div>
            <p>{{ product.description | strip_html | truncate: 90 }}</p>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces from the runway" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
