<header class="site-header">
  <a href="{{ routes.root_url }}" class="brand" aria-label="{{ 'header.home' | t: brand: settings.brand_name }}">
    <span class="brand-name">{{ settings.brand_name }}</span>
  </a>

  {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
    <nav aria-label="{{ 'header.main_nav' | t }}">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <a id="open-bag" href="{{ routes.cart_url }}" aria-label="{{ 'header.open_bag' | t }}">
    <svg width="22" height="24" viewBox="0 0 24 26" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 8h16l1 16H3L4 8zM8 8V6a4 4 0 0 1 8 0v2"/></svg>
    <span data-cart-count>{{ cart.item_count }}</span>
  </a>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
