<div class="sx-wrap sx-page">
  <p class="sx-eyebrow">{{ 'cart.eyebrow' | t }}</p>
  <h1 class="sx-h1">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="sx-empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="sx-btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <div class="sx-bag">
      <div class="sx-rows">
        {%- for item in cart.items -%}
          <div class="sx-row" data-cart-line="{{ forloop.index }}">
            <div class="sx-row__img">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 168 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="84" height="105" loading="lazy">{%- endif -%}
            </div>
            <div>
              <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
              {%- unless item.product.has_only_default_variant -%}<p>{{ item.variant.title }}</p>{%- endunless -%}
              <p>{{ item.final_price | money }}</p>
            </div>
            <div class="sx-row__end">
              <div class="sx-qty">
                <button type="button" data-qty="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">−</button>
                <output>{{ item.quantity }}</output>
                <button type="button" data-qty="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">+</button>
              </div>
              <span>{{ item.final_line_price | money }}</span>
              <button class="sx-rm" type="button" data-qty="0" aria-label="{{ 'cart.remove_label' | t: title: item.product.title }}">{{ 'cart.remove' | t }}</button>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <form class="sx-sum" action="{{ routes.cart_url }}" method="post">
        <h2>{{ 'cart.summary' | t }}</h2>
        <div class="sx-sum__r"><span>{{ 'cart.pieces' | t: count: cart.item_count }}</span><span>{{ cart.total_price | money }}</span></div>
        <div class="sx-sum__r sx-sum__r--t"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <small>{{ 'cart.delivery_note' | t }}</small>
        <button class="sx-btn" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        <a class="sx-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </form>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
