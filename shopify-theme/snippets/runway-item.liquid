{%- comment -%}
  One shoppable piece inside a look panel.
  Params: product, number, uid (unique id prefix)
{%- endcomment -%}
{%- assign image = product.featured_image -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign picker_id = 'Picker-' | append: uid -%}
<li class="rw__item{% unless product.available %} is-soldout{% endunless %}" data-rw-card="{{ number }}" style="--i:{{ number }}" data-title="{{ product.title | escape }}">
  <a class="rw__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if image -%}
      <img src="{{ image | image_url: width: 400 }}" alt="" width="400" height="{{ 400 | divided_by: image.aspect_ratio | round }}" loading="lazy" decoding="async">
    {%- endif -%}
    <span class="rw__num">{{ number }}</span>
  </a>
  <div class="rw__info">
    <span class="rw__type">{{ product.vendor }}</span>
    <a class="rw__name" href="{{ product.url }}">{{ product.title }}</a>
    <span class="rw__price"><span>{{ variant.price | money }}</span></span>
  </div>

  {%- if product.available -%}
    <button class="rw__add" type="button" data-rw-add aria-expanded="false" aria-controls="{{ picker_id }}" aria-label="{{ 'product.add' | t }}: {{ product.title | escape }}" data-added-label="{{ 'runway.added_to_bag' | t: title: product.title }}">
      <svg class="rw__ic-plus" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg>
      <svg class="rw__ic-check" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5l5 5L19.5 7"/></svg>
      <svg class="rw__ic-spin" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 1-9 9"/></svg>
    </button>

    <div class="rw__picker" id="{{ picker_id }}" data-rw-picker hidden>
      <div class="rw__picker-head">
        {%- if image -%}
          <img class="rw__picker-thumb" src="{{ image | image_url: width: 160 }}" alt="" width="160" height="{{ 160 | divided_by: image.aspect_ratio | round }}" loading="lazy">
        {%- endif -%}
        <span>
          <span class="rw__picker-title">{{ product.title }}</span>
          <span class="rw__picker-price">{{ variant.price | money }}</span>
        </span>
        <button class="rw__picker-close" type="button" data-rw-pick-close aria-label="{{ 'runway.close' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
      </div>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="rw__opt">
            <legend class="rw__opt-name">{{ option.name }}</legend>
            <div class="rw__opt-values">
              {%- for value in option.values -%}
                <label class="rw__pill">
                  <input type="radio" name="Opt-{{ uid }}-{{ forloop.parentloop.index }}" value="{{ value | escape }}" data-rw-option="{{ forloop.parentloop.index0 }}"{% if variant.options[forloop.parentloop.index0] == value %} checked{% endif %}>
                  <span class="rw__pill-label">{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <button class="rw__confirm" type="button" data-rw-confirm>
        <span data-rw-confirm-label data-add="{{ 'runway.add_to_bag' | t }}">{{ 'runway.add_to_bag' | t }}</span>
        <span class="rw__sr"> — {{ product.title }}</span>
      </button>

      <script type="application/json" data-rw-variants>
        [{%- for v in product.variants -%}{"id":{{ v.id }},"a":{{ v.available | json }},"o":{{ v.options | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
      </script>
    </div>
  {%- else -%}
    <button class="rw__add" type="button" disabled aria-label="{{ 'product.sold_out' | t }}: {{ product.title | escape }}">
      <svg class="rw__ic-plus" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg>
    </button>
  {%- endif -%}
</li>
