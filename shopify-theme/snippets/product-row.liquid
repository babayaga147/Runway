{%- comment -%}
  Product article used on collection and product pages.
  Params: product, reverse (boolean), eager (boolean), heading (h1 or h2)
{%- endcomment -%}
{%- assign image = product.featured_image -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign tag = heading | default: 'h2' -%}
<article class="sx-prod{% if reverse %} sx-prod--rev{% endif %}" id="{{ product.handle }}">
  <div class="sx-prod__media">
    {%- if image -%}
      <img src="{{ image | image_url: width: 800 }}" alt="{{ image.alt | default: product.title | escape }}" width="800" height="{{ 800 | divided_by: image.aspect_ratio | round }}" loading="{% if eager %}eager{% else %}lazy{% endif %}" decoding="async">
    {%- endif -%}
  </div>
  <div class="sx-prod__info">
    <p class="sx-eyebrow">{{ product.vendor }}</p>
    <{{ tag }}>{{ product.title }}</{{ tag }}>
    <p class="sx-price">{{ variant.price | money }}</p>
    <p class="sx-desc">{{ product.description | strip_html | truncate: 220 }}</p>

    {%- form 'product', product, data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">

      {%- unless product.has_only_default_variant -%}
        <div data-variant-picker>
          {%- for option in product.options_with_values -%}
            <fieldset class="sx-size">
              <legend>{{ option.name }}</legend>
              <div class="sx-pills">
                {%- for value in option.values -%}
                  <label class="sx-pill">
                    <input type="radio" name="{{ product.id }}-option-{{ forloop.parentloop.index }}" value="{{ value | escape }}"{% if variant.options[forloop.parentloop.index0] == value %} checked{% endif %}>
                    <span>{{ value }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
          <script type="application/json" data-variants>
            [{%- for v in product.variants -%}{"id":{{ v.id }},"available":{{ v.available | json }},"options":{{ v.options | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
          </script>
        </div>
      {%- endunless -%}

      <div class="sx-actions">
        <button class="sx-btn" type="submit" data-add="{{ 'product.add' | t }}" data-added="{{ 'product.added' | t }}"{% unless variant.available %} disabled{% endunless %}>
          {%- if variant.available -%}{{ 'product.add' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
        </button>
        <a class="sx-link" href="{{ routes.cart_url }}" data-bag-link hidden>{{ 'product.view_bag' | t }}</a>
      </div>
    {%- endform -%}
  </div>
</article>
